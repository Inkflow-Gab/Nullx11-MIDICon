{
  "name": "nullx-midicon",
  "private": true,
  "version": "1.0.0",
  "description": "Convenience scripts for the MIDICon web studio. Python dependencies live in requirements-web.lock.",
  "scripts": {
    "start": "bash scripts/run_web.sh",
    "build": "cd web && npm run build",
    "dev": "cd web && npm run dev",
    "dev:api": ".venv/bin/python -m uvicorn webapp.main:app --host 0.0.0.0 --port 8000 --reload",
    "test": ".venv/bin/python -m pytest tests/web/test_studio.py -q",
    "test:models": "RUN_REAL_MODEL_TESTS=1 .venv/bin/python -m pytest tests/web/test_real_models.py -q",
    "test:e2e": "cd web && npx playwright test",
    "android:build": "cd android && ./gradlew :app:assembleDebug",
    "android:test": "cd android && ./gradlew :app:testDebugUnitTest :app:lintDebug"
  }
}
